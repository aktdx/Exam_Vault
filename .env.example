# Node environment
NODE_ENV=development
PORT=3000

# PostgreSQL / Neon Database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=require&channel_binding=require
SQL_HOST=YOUR_DB_HOST
SQL_USER=YOUR_DB_USER
SQL_PASSWORD=YOUR_DB_PASSWORD
SQL_DB_NAME=YOUR_DB_NAME

# Firebase client SDK (browser) — must all come from the SAME Firebase web app:
# Console > Project settings > Your apps > Web app > SDK setup and configuration.
# Mixing fields from two projects causes auth/unauthorized-domain at sign-in.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Backend API base URL used by the frontend
VITE_API_URL=YOUR_API_BASE_URL

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"

# Super-admin access — comma-separated list of emails granted super-admin privileges
SUPERADMIN_EMAILS=admin@example.com
